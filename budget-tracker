<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Budget Tracker</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header id="main-header">
        <h1>My Budget Tracker</h1>
        <p class="subtitle">Track your income and expenses in one place.</p>
    </header>

    <main>
        <section id="add-expense-section" class="card">
            <h2>Add Expense</h2>
            <div class="input-group">
                <label for="expense-name">Expense Name</label>
                <input type="text" id="expense-name" placeholder="e.g., Groceries">
            </div>
            <div class="input-group">
                <label for="expense-amount">Amount ($)</label>
                <input type="number" id="expense-amount" placeholder="0.00">
            </div>
            <div class="input-group">
                <label for="expense-category">Category</label>
                <input type="text" id="expense-category" placeholder="e.g., Food">
            </div>
            <button type="button" class="btn">Add Expense</button>
        </section>

        <section id="expenses-list-section" class="card">
            <h2>Your Expenses</h2>
            <p class="placeholder-text">No expenses yet</p>
        </section>
    </main>
</body>
</html>/* Element Selector */
body {
    font-family: Arial, sans-serif;
    background-color: #f4f6f9;
    color: #333333;
    margin: 0;
    padding: 20px;
}

/* ID Selector */
#main-header {
    text-align: center;
    margin-bottom: 30px;
}

#main-header h1 {
    color: #2c3e50;
    font-size: 2.5rem;
    margin-bottom: 5px;
}

/* Class Selector */
.subtitle {
    color: #7f8c8d;
    font-size: 1.1rem;
}

.card {
    background-color: #ffffff;
    border-radius: 8px;
    padding: 20px;
    margin: 20px auto;
    max-width: 500px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.input-group {
    margin-bottom: 15px;
}

.input-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
    color: #34495e;
}

.input-group input {
    width: 100%;
    padding: 10px;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    box-sizing: border-box;
}

.btn {
    background-color: #3498db;
    color: white;
    padding: 10px 15px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
    width: 100%;
}

.btn:hover {
    background-color: #2980b9;
}

.placeholder-text {
    color: #95a5a6;
    font-style: italic;
    text-align: center;
}
